{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "config": {
      "joinCode": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 40"
      },
      "groups": {
        ".read": "auth != null",
        "$g": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "$g.matches(/^g[1-5]$/)"
        }
      },
      "share": {
        ".read": "auth != null",
        "$k": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "$k.matches(/^(stakeholder|cna|experts|kanban)$/) && newData.isBoolean()"
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "name": {
          ".write": "auth != null && (auth.uid === $uid || (auth != null && root.child('admins').child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === auth.token.email"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "joinCode": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && auth.token.email.toLowerCase().matches(/@([a-z0-9-]+\\.)*misis\\.ru$/)",
          ".validate": "newData.val() === root.child('config').child('joinCode').val()"
        },
        "group": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^g[1-5]$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "emailIndex": {
      "$k": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && auth.token.email.toLowerCase().replace('.', ',').beginsWith($k + '@'))",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && auth.token.email.toLowerCase().replace('.', ',').beginsWith($k + '@') && !data.exists() && newData.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$g": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('joinCode').exists()",
        "$uid": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && auth.uid === $uid && root.child('users').child($uid).child('group').val() === $g)",
          ".validate": "$g.matches(/^g[1-5]$/) && newData.isString() && newData.val().length <= 80"
        }
      }
    },
    "groups": {
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists() && (root.child('config').child('share').child('stakeholder').val() === true || root.child('config').child('share').child('cna').val() === true || root.child('config').child('share').child('kanban').val() === true || root.child('config').child('share').child('experts').val() === true))",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g)"
      }
    },
    "cna": {
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists() && root.child('config').child('share').child('cna').val() === true)",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g)"
      }
    },
    "experts": {
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists() && root.child('config').child('share').child('experts').val() === true)",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g)"
      }
    },
    "kanban": {
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists() && root.child('config').child('share').child('kanban').val() === true)",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g)"
      }
    },
    "seminarWorkspace": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists())",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').exists() && root.child('users').child(auth.uid).child('group').val().replace('g', 'group') === $g)",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 12000"
        }
      }
    },
    "stakeholder": {
      "$g": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g) || (auth != null && root.child('users').child(auth.uid).child('joinCode').exists() && root.child('config').child('share').child('stakeholder').val() === true)",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('group').val() === $g)"
      }
    }
  }
}
